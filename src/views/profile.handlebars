<h2>Usuario {{usuario.nombre}}</h2>
<hr>
<h3>Datos usuario:</h3>
<p>Nombre: <strong>{{usuario.nombre}}</strong></p>
<p>correo: <strong>{{usuario.email}}</strong></p>
<hr>
<form id="upload-form" action="/api/user/{{usuario._id}}/documents" method="post" enctype="multipart/form-data">
        <p>Subir foto de perfil</p>
        <input type="file" name="profile">
        <input type="text" name="name" placeholder="nombre">
        <input type="submit" value="grabar">

</form> 

{{>menu}}

